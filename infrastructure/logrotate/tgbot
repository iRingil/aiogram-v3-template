# Rotation of the bot log.
# Install: copy to /etc/logrotate.d/tgbot; check with `logrotate --debug /etc/logrotate.d/tgbot`.
#
# copytruncate: the bot keeps its log open, so the file is copied and emptied in place instead of being moved;
# no restart, no missed updates (a line written during the copy may be lost).

/opt/tgbot/src/logs/*.log {
    # The folder belongs to the user `tgbot`; logrotate works in it as that user
    su tgbot tgbot
    daily
    rotate 7
    missingok
    notifempty
    compress
    delaycompress
    copytruncate
}
