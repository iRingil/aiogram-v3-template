# An example of a file with environment variables. Insert your values and rename this file to .env
BOT_TOKEN=
ADMIN_IDS=

# Mode switches (true/false, false when absent)
DEBUG=True
USE_WEBHOOK=False
USE_REDIS=False
USE_REDIS_SOCKET=False
USE_POSTGRES_SOCKET=False

# Redis storage
REDIS_HOST=
REDIS_PORT=
REDIS_SOCKET_PATH=
REDIS_DB_INDEX=
REDIS_DB_USER=
REDIS_DB_PASS=

# PostgreSQL database (PG_SOCKET_PATH: the socket file, e.g. /var/run/postgresql/.s.PGSQL.5432)
PG_HOST=127.0.0.1
PG_PORT=5432
PG_SOCKET_PATH=
PG_DB_NAME=
PG_DB_USER=
PG_DB_PASS=

# Webhook credentials
WEBHOOK_HOST=
WEBHOOK_PATH=
WEBHOOK_TOKEN=
WEBAPP_HOST=
WEBAPP_PORT=
